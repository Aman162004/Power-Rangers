# JWT Configuration
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_HOURS=2
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Fallback Configuration
# If set to true, the backend will return dummy data (sampled from historical data) 
# when model inference fails. If false (default), inference failures return HTTP 500.
# Note: When true, the frontend will display the dummy data graph normally.
# When false, the frontend will show an error and no graph.
ENABLE_DUMMY_FALLBACK=false
