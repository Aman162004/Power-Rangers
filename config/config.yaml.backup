data:
  # Historical lane: immutable training data, locked for model development only
  historical_raw_path: "data/historical/raw/"
  historical_feature_engineered_path: "data/historical/feature_engineered/"
  historical_final_processed_path: "data/historical/final_processed/"
  historical_merged_file: "data/historical/raw/electricity_demand_2021-01-01_to_2026-04-06.csv"
  historical_demand_load_path: "data/historical/raw/demand_load/"
  historical_weather_path: "data/historical/raw/weather/"
  historical_calendar_path: "data/historical/raw/calendar/"
  
  # Operational lane: ephemeral scraping data for future inference only
  operational_raw_path: "data/operational/raw/"
  operational_processed_path: "data/operational/processed/"
  
  # Models and metadata
  models_root: "models/"
  models_checkpoints_dir: "models/runs/"
  models_config_dir: "models/config/"
  active_model_pointer: "models/ACTIVE_MODEL.txt"
  # Canonical best checkpoint — used by inference, export, and testing pipelines
  best_model_path: "models/runs/20260416_162000/epoch=epoch=10-val_loss=val_loss=138.47.ckpt"
  prep_metadata_path: "data/historical/final_processed/prep_metadata.json"
  
  # Training input (splits)
  historical_splits_path: "data/historical/final_processed/"
  training_splits:
    train: "train_data.parquet"
    val: "val_data.parquet"
    test: "test_data.parquet"
  
  # Features to drop (audit, redundant, or pre-processing artifacts)
  training_drop_columns:
    - "day_of_year"  # redundant with hour, day_of_week, month
    - "week_of_year"  # redundant
    - "is_weekend"  # derivable from day_of_week
    - "load_mw_raw"  # original before outlier clipping; use clipped version
    - "load_outlier_detected"  # flag only, not a feature
    # Drop all audit columns: *_was_missing
  training_drop_pattern: ".*_was_missing$"

ingestion:
  start_date: "2026-04-07"
  end_date: "2026-04-13"
  base_csv_path: "data/historical/raw/demand_load/powerdemand_5min_2021_to_2024_load_only.csv"
  latitude: 28.6139
  longitude: 77.2090
  timezone: "Asia/Kolkata"
  retry_total: 5
  backoff_factor: 0.3
  timeout_seconds: 10
  sldc_sleep_seconds: 0.4
  weather_cache_path: ".cache/openmeteo"
  outputs:
    load_snapshot: "data/operational/raw/load_sldc_{start_date}_to_{end_date}.csv"
    weather_snapshot: "data/operational/raw/weather_openmeteo_{start_date}_to_{end_date}.csv"
    merged_snapshot: "data/operational/raw/electricity_demand_{start_date}_to_{end_date}.csv"
    manifest: "data/operational/raw/ingestion_manifest_{start_date}_to_{end_date}.json"

pipeline:
  encoder_window: 24  # 6 hours of look-back (24 steps × 15 min = 360 min); lag_672 engineered feature covers weekly context — prevents overfitting
  decoder_window: 192   # 48 hours prediction (fixed requirement — doubles any reviewed paper's 24h horizon)
  stride: 1
  # Chronological splits — no shuffling (prevents data leakage from future to past)
  data_split_ratios:
    train: 0.70
    val: 0.15
    test: 0.15

features:
  lags: [4, 24, 96, 672]  # 1h, 6h, 24h, 7-days — lag_672 captures weekly seasonality (key for electricity demand)
  rolling_windows: [4, 24]  # 1h, 6h
  # IQR outlier multiplier — controls how aggressively demand spikes are clipped.
  # EDA confirmed 0 outliers at 3×IQR; 2.0 is conservative and production-appropriate.
  iqr_multiplier: 2.0  # EDA-validated: ~2.5% rows clipped; 1.5 was too aggressive (5.7% rows = 10,568 rows)

model:
  hidden_size: 64          # CV confirmed: 64 wins (128 OOM on 6GB card)
  attention_head_size: 4
  dropout: 0.15             # EDA: CV=30.55% demands regularization; 0.1 caused overfitting in earlier runs
  hidden_continuous_size: 8   # Back to 8 — proven to get MAPE=6.86%; 16 caused overfitting
  output_size: 3  # Must equal len(quantiles); maps to [0.1, 0.5, 0.9] — 80% confidence interval + median
  loss: "quantile"  # or "mae"
  quantiles: [0.1, 0.5, 0.9]
  learning_rate: 0.0003     # Keep — this fix worked (was the gradient_clip=0.1 that killed us, not LR)
  reduce_on_plateau_patience: 3  # Decay LR after 3 non-improving epochs
  max_epochs: 50          # Full run — model needs sufficient epochs to converge
  batch_size: 256   # Smaller batches = better gradient estimates = better generalisation

training:
  early_stopping_patience: 6
  checkpoint_every: 5
  resume_policy: "scratch"   # Clean start — no stale scheduler/optimizer state from old runs
  resume_weights_only: false
  checkpoint_save_strategy: "all"
  checkpoint_every_n_epochs: 1
  precision: "16-mixed"
  num_workers: 0
  pin_memory: true
  persistent_workers: false
  prefetch_factor: null
  cudnn_benchmark: true
  gradient_clip_val: 0.5       # Keep — this was the primary fix that allowed learning
  gradient_clip_algorithm: "norm"
  lr_warmup:
    epochs: 2               # 3-epoch warmup for clean cold start
    start_lr: 0.00003        # Start at 10x below target LR
